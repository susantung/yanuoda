flowchart LR
    A["合作伙伴建档\n企业 / 个人 / 公共临时客户"] --> B["账户与额度管理\n双账户或临客挂帐账户"]
    B --> C["后台充值申请\n充值、调账、其他收入"]
    C --> D["售票窗口\n选择固定伙伴或公共临时客户"]
    D --> E["窗口充值与确认出票\n支付方式锁定、二次校验"]
    E --> F["散客订单与消费流水"]
    F --> G{"公共临时客户后续处理"}
    G -->|"逐单挂帐回款"| H["订单和消费流水标记已回款\n余额仅计其他收入"]
    G -->|"转长期合作伙伴"| I["迁移订单和售后归属\n重建目标伙伴流水、生成调账-往来"]
    F --> J["售后退款\n按订单当前归属与回款状态分流"]
    H --> K["资金流水与详情追溯"]
    I --> K
    J --> K
    K --> L["合作伙伴对帐单\n按日 / 按月统计"]
