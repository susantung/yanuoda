flowchart TD
    A["后台维护合作伙伴档案"] --> B{"合作类型"}
    B -->|"企业 / 个人"| C["同一事务建立挂帐、预付款两个子账户"]
    B -->|"公共临时客户"| D["系统唯一公共临时客户\n仅建立挂帐子账户、固定启用"]
    C --> E["配置账户支付方式、账户状态及额度限制"]
    D --> F["配置挂帐额度限制\n公共临时客户支付方式固定为挂帐"]

    E --> G["后台充值申请"]
    F --> G
    G --> H{"充值对象"}
    H -->|"企业 / 个人"| I{"充值类型"}
    I -->|"挂帐 / 预付款"| I1["金额大于 0\n写入当前账户支付方式对应子账户\n生成充值记录和充值流水"]
    I -->|"调账"| I2["金额可正可负且不为 0\n不填写支付时间和支付方式\n写入当前配置子账户及调账流水"]
    I -->|"其他收入"| I3["金额大于 0\n不改变任何账户\n生成独立其他收入记录和流水"]
    H -->|"公共临时客户"| J{"挂帐回款或调账"}
    J -->|"调账"| J1["金额可正可负且不为 0\n写入挂帐账户及调账流水"]
    J -->|"挂帐回款"| J2["填写充值金额后选择待回款订单"]
    J2 --> J3{"候选订单均为：公共临时客户、挂帐、未回款、应回款大于 0"}
    J3 --> J4{"多笔订单的客户名称和负责人快照是否一致"}
    J4 -->|"一致 / 单笔"| J5["计算已选订单应回款合计\n订单金额减已成功退款金额"]
    J4 -->|"不一致"| J6{"人工二次确认是否继续"}
    J6 -->|"返回修改"| J2
    J6 -->|"确认继续"| J5
    J5 --> J7{"充值金额是否小于已选应回款合计"}
    J7 -->|"是"| J8["拦截提交\n提示先转为长期合作伙伴"]
    J7 -->|"否"| J9{"是否存在剩余金额"}
    J9 -->|"否"| J10["生成挂帐充值记录\n关联订单及消费流水标记已回款"]
    J9 -->|"是"| J11["剩余金额只能计入其他收入\n同步生成独立其他收入记录"]
    J11 --> J10

    C --> K["售票窗口：临时 / 长期合作伙伴模式"]
    D --> K
    K --> L{"选择对象"}
    L -->|"企业 / 个人"| M["选择启用的固定合作伙伴\n加载负责人、联系人及账户支付方式"]
    L -->|"公共临时客户"| N["快捷选择公共临时客户\n填写订单客户名称和订单负责人快照"]
    M --> O{"是否在窗口先充值"}
    O -->|"是"| O1["固定合作伙伴充值\n充值金额和计入其他收入至少一项大于 0"]
    O1 --> O2{"充值事务是否成功"}
    O2 -->|"否"| O3["整体回滚并提示充值失败"]
    O2 -->|"是"| O4["生成账户充值 / 其他收入及流水\n仅刷新右侧账户信息，不刷新已选门票"]
    O4 --> P["选择散客票并确认下单"]
    O -->|"否"| P
    N --> P
    P --> Q["打开支付订单确认弹窗\n支付方式为合作伙伴账户支付方式，锁定不可切换"]
    Q --> R["确认出票时重新读取合作伙伴和账户最新状态"]
    R --> S{"是否通过通用状态校验"}
    S -->|"否：伙伴或账户已禁用"| S1["拦截出票"]
    S -->|"是"| T{"订单对象"}
    T -->|"公共临时客户"| U{"客户名称和订单负责人是否均已填写"}
    U -->|"否"| U1["拦截出票并提示补充必填信息"]
    U -->|"是"| V{"挂帐额度限制启用且可用额度不足"}
    T -->|"企业 / 个人"| W{"账户支付方式"}
    W -->|"挂帐"| V
    W -->|"预付款"| X{"预付款额度限制启用且余额不足"}
    V -->|"是"| V1["拦截出票\n提示充值或调整额度"]
    V -->|"否"| Y["扣减挂帐账户"]
    X -->|"是"| X1["拦截出票\n提示先充值"]
    X -->|"否"| Z["扣减预付款账户"]
    Y --> AA["同一事务：创建散客订单、出票、生成消费流水"]
    Z --> AA
    AA --> AB{"是否为公共临时客户订单"}
    AB -->|"是"| AC["订单初始未回款\n消费流水展示未回款\n订单详情展示客户和负责人快照"]
    AB -->|"否"| AD["订单详情展示当前合作伙伴信息\n不维护订单回款状态"]

    AC --> AE{"后续业务"}
    AE -->|"挂帐回款"| J2
    AE -->|"临时客户转合作伙伴"| AF["选择未回款、动态应回款大于 0 的公共临时客户订单"]
    AF --> AG{"多笔订单客户和负责人快照是否一致"}
    AG -->|"一致 / 人工确认继续"| AH{"迁移目标"}
    AG -->|"不一致"| AI{"人工二次确认是否继续"}
    AI -->|"返回修改"| AF
    AI -->|"确认继续"| AH
    AH -->|"新建企业 / 个人"| AJ["创建长期合作伙伴及双子账户"]
    AH -->|"选择已有伙伴"| AK["仅可选择启用的企业 / 个人"]
    AJ --> AL["同一事务迁移"]
    AK --> AL
    AL --> AM["订单和关联售后单改为目标伙伴当前归属"]
    AL --> AN["公共临时客户原消费、退款流水保留不改"]
    AL --> AO["目标伙伴按当前账户支付方式重建消费负数、退款正数流水"]
    AL --> AP["公共临时客户生成正数调账-往来充值及调账流水\n金额为订单总额减关联退款总额"]
    AL --> AQ["已迁移订单详情在合作伙伴信息下增加变更记录\n原伙伴、现伙伴、操作人、变更时间"]
    AL --> AR{"迁移事务是否成功"}
    AR -->|"否"| AS["整体回滚：不创建伙伴、不迁移订单、不生成流水"]
    AR -->|"是"| AT["迁移订单不再参与公共临时客户回款\n后续按目标伙伴普通账户规则处理"]

    AD --> BA["售后退款成功"]
    AC --> BA
    AT --> BA
    BA --> BB{"订单当前归属及回款状态"}
    BB -->|"企业 / 个人或已迁移订单"| BC["按当前订单支付账户增加退款金额\n生成退款正数流水"]
    BB -->|"公共临时客户，未回款"| BD["增加挂帐账户\n生成退款流水并动态减少订单应回款金额"]
    BB -->|"公共临时客户，已回款"| BE["先生成退款正数流水\n再生成同额负数已回款订单退款调账"]

    I1 --> CA["资金流水与详情追溯"]
    I2 --> CA
    I3 --> CA
    J1 --> CA
    J10 --> CA
    BC --> CA
    BD --> CA
    BE --> CA
    AN --> CA
    AO --> CA
    AP --> CA
    CA --> CB["资金流水按充值、消费、退款、其他收入、调账展示\n按发生时间、单据和快照追溯"]
    CB --> CC["合作伙伴对帐单"]
    CC --> CD["按日默认当天 / 按月默认当月\n必须选择合作伙伴，候选含启用、禁用、公共临时客户"]
    CD --> CE["按日期统计人数、消费、到款\n范围内调账单列；合计行展示查询时当前预付款余额和挂帐金额"]
