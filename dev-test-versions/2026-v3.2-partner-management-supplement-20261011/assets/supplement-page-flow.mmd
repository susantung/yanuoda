    incoming --> capital
    moved --> capital
    use --> windowReport["W16 窗口充值报表"]
    ordinary --> windowReport
    incoming --> windowReport
    moved -->|"不纳入收款报表"| orderView["R01 原订单详情"]
    use -->|"目标为临客回款"| paid["W05 已回款视图及R01订单查看"]
    ordinary -->|"目标为临客回款"| paid
    records -.-> backendReport["B12 原后台对帐单：共享数据"]
